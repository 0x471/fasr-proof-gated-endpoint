# Built in, not modules: nothing on the image loads modules, and the firewall must exist before the network.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CT=y
# Hardening: no loadable modules, the kernel locked down against reading or changing itself, no raw
# memory, debugger or tracing interfaces (kprobes go with modules), and nothing the device doesn't use (IPv6, radios, sound, USB).
# CONFIG_MODULES is not set
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="lockdown,yama,landlock"
# CONFIG_DEVMEM is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KGDB is not set
# CONFIG_FTRACE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USER_NS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_IPV6 is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
