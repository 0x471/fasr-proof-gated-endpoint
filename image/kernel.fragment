# Built in, not modules: nothing on the image loads modules, and the firewall must exist before the network.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CT=y
# Hardening: the kernel locked down against reading or changing itself, no raw memory, debugger or
# tracing interfaces, and nothing the device doesn't use (IPv6, radios, sound, USB). Modules stay
# configurable (turning them off builds every driver in) but none ship and loading is switched off at
# boot (overlay /etc/sysctl.d/90-pge.conf).
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="lockdown,yama,landlock"
# Lockdown turns on module signing. No signing key at all: the build then embeds no certificate (a
# generated one would differ in every build, so two builds couldn't be compared) and no module can
# ever be verified, so lockdown refuses every module even if loading were switched back on.
CONFIG_MODULE_SIG_KEY=""
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_KGDB is not set
# CONFIG_FTRACE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USER_NS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_IPV6 is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
