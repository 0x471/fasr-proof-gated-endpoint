# Added to Buildroot's raspberrypi4_64_defconfig for the v1 image.
# The endpoint is one static binary: no Python, no EZKL CLI, no libc needed at run time.
# Static address from the overlay instead of DHCP on eth0.
BR2_SYSTEM_DHCP=""
# Keep the root filesystem read-only after boot; logs and run state live on tmpfs.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# 4 KiB blocks: dm-verity presents the root with its own block size (post-image.sh), and ext4 can't
# mount 1 KiB blocks (the default for this size) on it. A fixed UUID and hash seed: mkfs picks random
# ones, so every build would get another root hash on the kernel command line.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -b 4096 -U 70676500-0000-4000-8000-000000000001 -E hash_seed=70676500-0000-4000-8000-000000000002"
# The firewall (rules in the overlay's /etc/nftables.conf).
BR2_PACKAGE_NFTABLES=y
# No login anywhere: no getty on the console and a locked root account. Updates arrive as a new image
# or are applied to the card's store on another machine (docs/UPDATE_SPEC.md).
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# Kernel lockdown turns on module signing, whose build tools need OpenSSL on the host.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Build times, users and host names out of the image, so a second build can be compared byte for byte
# (Buildroot also needs the same output directory: image/build.sh's WORK).
BR2_REPRODUCIBLE=y
